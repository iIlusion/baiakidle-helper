{
  "name": "leviticus-extension",
  "version": "1.4.0",
  "description": "Leviticus Extension — Tampermonkey automation for BaiakIdle.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iIlusion/baiakidle-helper.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/add-userscript-banner.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/check-rates.mjs && vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.76",
    "@radix-ui/react-switch": "^1.3.7",
    "msgpackr": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
